      style: "$body"
      align: [center, middle]
      bold: true
      text: route_v1.json
  - elementId: p2-route-sub
    elementType: text
    bounds: [382, 185, 146, 18]
    content:
      style: "$bodySmall"
      align: [center, top]
      color: "$muted"
      text: 米制 / local_enu
  - elementId: p2-vehicle-text
    elementType: text
    bounds: [648, 140, 215, 42]
