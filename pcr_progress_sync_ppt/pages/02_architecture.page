      style: "$inverse"
      align: [center, middle]
      text: ROS 车辆端
  - elementId: p2-vehicle-sub
    elementType: text
    bounds: [648, 183, 215, 26]
    content:
      style: "$bodySmall"
      color: "#FFFFFF"
      align: [center, middle]
      text: 底盘 / 雷达 / EKF / SLAM / 跟踪
  - elementId: p2-data-text
