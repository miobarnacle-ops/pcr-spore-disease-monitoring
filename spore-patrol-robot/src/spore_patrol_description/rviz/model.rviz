Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 130; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: C50X Spore Patrol Robot
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Name: Coordinate Frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Simulated LiDAR
      Topic:
        Value: /scan
      Size (Pixels): 3
      Style: Flat Squares
      Color: 255; 80; 30
  Global Options:
    Background Color: 24; 30; 34
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.25
      Pitch: 0.55
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1440

