<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spore_patrol_robot">
  <!--
    WHEELTEC high-configuration pendulum-suspension chassis.
    Dimensions are from docs/小车相关参数/小车二维模型图纸.jpg.
    The payload and sensor mounting positions remain provisional.
  -->
  <xacro:property name="half_track" value="0.1678"/>
  <xacro:property name="half_wheelbase" value="0.15635"/>
  <xacro:property name="wheel_radius" value="0.076"/>
  <xacro:property name="wheel_width" value="0.048"/>
  <xacro:property name="chassis_length" value="0.3127"/>
  <xacro:property name="chassis_width" value="0.238"/>
  <xacro:property name="chassis_height" value="0.09"/>
  <xacro:property name="chassis_z" value="0.096"/>

  <material name="orange">
    <color rgba="0.96 0.45 0.08 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.08 0.10 0.12 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.65 0.70 0.75 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.05 0.42 0.75 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.15 0.65 0.32 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="7.6"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.17" iyz="0" izz="0.23"/>
    </inertial>
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <xacro:macro name="fixed_wheel" params="name x y">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:fixed_wheel name="front_left_wheel" x="${half_wheelbase}" y="${half_track}"/>
  <xacro:fixed_wheel name="front_right_wheel" x="${half_wheelbase}" y="${-half_track}"/>
  <xacro:fixed_wheel name="rear_left_wheel" x="${-half_wheelbase}" y="${half_track}"/>
  <xacro:fixed_wheel name="rear_right_wheel" x="${-half_wheelbase}" y="${-half_track}"/>

  <joint name="sensor_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_deck"/>
    <origin xyz="0 0 0.12"/>
  </joint>
  <link name="sensor_deck">
    <visual>
      <geometry>
        <box size="0.34 0.22 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="sensor_deck"/>
    <child link="payload_link"/>
    <origin xyz="-0.10 0 0.15"/>
  </joint>
  <link name="payload_link">
    <visual>
      <geometry>
        <box size="0.34 0.32 0.25"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="sensor_deck"/>
    <child link="mast_link"/>
    <origin xyz="0.16 0 0.25"/>
  </joint>
  <link name="mast_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.46"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.27"/>
  </joint>
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.065"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0.07 0 0.13"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.10 0.16 0.065"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="gnss_left_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="gnss_left_link"/>
    <origin xyz="0 0.22 0.27"/>
  </joint>
  <link name="gnss_left_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="gnss_right_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="gnss_right_link"/>
    <origin xyz="0 -0.22 0.27"/>
  </joint>
  <link name="gnss_right_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="sensor_deck">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="payload_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="laser_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!--
    This plugin provides a robust first visual demo. It is intentionally
    kinematic; a calibrated four-wheel skid-steer dynamics model will replace it.
  -->
  <gazebo>
    <plugin name="planar_drive" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.001</covariance_x>
      <covariance_y>0.001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>
</robot>
