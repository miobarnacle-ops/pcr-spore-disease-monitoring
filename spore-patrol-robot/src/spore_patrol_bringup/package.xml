  <version>0.1.0</version>
  <description>Top-level launch files for the spore patrol robot.</description>
  <maintainer email="team@example.com">Spore Patrol Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>spore_patrol_description</exec_depend>
  <exec_depend>spore_patrol_base_driver</exec_depend>
  <exec_depend>spore_patrol_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
