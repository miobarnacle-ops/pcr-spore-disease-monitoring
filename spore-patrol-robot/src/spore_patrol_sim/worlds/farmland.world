<?xml version="1.0"?>
<sdf version="1.6">
  <world name="spore_patrol_farmland">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="soil">
      <static>true</static>
      <link name="soil_link">
        <collision name="soil_collision">
          <geometry>
            <box>
              <size>24 14 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="soil_visual">
          <geometry>
            <box>
              <size>24 14 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.17 0.08 1</ambient>
            <diffuse>0.42 0.24 0.10 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Parallel crop rows leave navigable corridors between them. -->
    <model name="crop_row_m4">
      <static>true</static>
      <pose>1 -4 0.25 0 0 0</pose>
      <link name="row">
        <collision name="collision"><geometry><box><size>18 0.22 0.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18 0.22 0.50</size></box></geometry><material><ambient>0.05 0.35 0.08 1</ambient><diffuse>0.08 0.62 0.12 1</diffuse></material></visual>
      </link>
    </model>
