<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spore_patrol_nav_bringup</name>
  <version>0.1.0</version>
  <description>Stage C bringup: robot_localization EKF and SLAM Toolbox launch/config for the spore patrol vehicle.</description>
  <maintainer email="dev@example.com">vehicle-team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>spore_patrol_base_driver</exec_depend>
  <exec_depend>spore_patrol_bringup</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
