<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="vendor_senior_4wd_bs_preview">
  <!--
    Visual-only preview converted from the manufacturer STEP assembly.

    The STEP coordinates are millimetres. The mesh is rotated so the long
    vehicle axis follows ROS +X and translated so its bounding box is centred
    on the XY origin with the lowest point on the ground plane.

    Do not use this dense mesh as a Gazebo/Nav2 collision model.
  -->
  <material name="vendor_blue">
    <color rgba="0.24 0.55 0.78 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- The manufacturer base_link origin is about 51 mm above the ground. -->
    <origin xyz="0 0 0.051" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.021497 0 0.063969"
              rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <mesh
          filename="package://spore_patrol_description/meshes/vendor/senior_4wd_bs_full.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="vendor_blue"/>
    </visual>
  </link>

  <!--
    Empty child links preserve the useful joint/frame locations from the
    manufacturer URDF. Their geometry is already part of the complete STEP
    assembly rendered on base_link.
  -->
  <link name="lf_wheel_link"/>
  <joint name="lf_wheel_joint" type="continuous">
    <origin xyz="0.155179519 0.167523202 0.025003" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lf_wheel_link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="lb_wheel_link"/>
  <joint name="lb_wheel_joint" type="continuous">
    <origin xyz="-0.157520481 0.167223202 0.024002" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lb_wheel_link"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="rb_wheel_link"/>
  <joint name="rb_wheel_joint" type="continuous">
    <origin xyz="-0.157525481 -0.165888798 0.023994" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rb_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rf_wheel_link"/>
  <joint name="rf_wheel_joint" type="continuous">
    <origin xyz="0.155174519 -0.166188798 0.024994" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rf_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.160834519 0.000745202 0.089704" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <origin xyz="0.091127865 0.000667202 0.111024184"
            rpy="0 0 3.141592653589793"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>

  <link name="controller_link"/>
  <joint name="controller_joint" type="fixed">
    <origin xyz="-0.072154314 -0.079693631 0.155" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="controller_link"/>
  </joint>
</robot>
