Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 110; 120; 110
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Manufacturer STEP Model
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.15
      Name: Coordinate Frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Global Options:
    Background Color: 24; 30; 34
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Focal Point:
        X: 0
        Y: 0
        Z: 0.11
      Pitch: 0.48
      Yaw: 0.82
Window Geometry:
  Height: 900
  Width: 1440
