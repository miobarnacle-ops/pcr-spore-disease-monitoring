<?xml version="1.0"?>
<sdf version="1.6">
  <world name="spore_patrol_single_ridge_8m">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- One 4.8 m ridge in an 8.0 m x 3.0 m working area. -->
    <model name="soil">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="soil_link">
        <collision name="soil_collision">
          <geometry>
            <box><size>8.0 3.0 0.10</size></box>
          </geometry>
        </collision>
        <visual name="soil_visual">
          <geometry>
            <box><size>8.0 3.0 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.30 0.17 0.08 1</ambient>
            <diffuse>0.42 0.24 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Eight 0.60 m boxes are represented by one equivalent ridge volume. -->
    <model name="single_ridge">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="ridge">
        <collision name="collision">
          <geometry><box><size>4.80 0.40 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.80 0.40 0.50</size></box></geometry>
          <material>
            <ambient>0.55 0.32 0.10 1</ambient>
            <diffuse>0.78 0.48 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Short cross-headland markers span both drive lanes. They make the 1.6 m
      headlands observable without adding continuous side walls.
    -->
    <model name="headland_marker_west">
      <static>true</static>
      <pose>-4.0 0 0.25 0 0 0</pose>
      <link name="marker">
        <collision name="collision">
            <geometry><box><size>0.12 2.20 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 2.20 0.50</size></box></geometry>
          <material>
            <ambient>0.45 0.28 0.08 1</ambient>
            <diffuse>0.65 0.40 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="headland_marker_east">
      <static>true</static>
      <pose>4.0 0 0.25 0 0 0</pose>
      <link name="marker">
        <collision name="collision">
            <geometry><box><size>0.12 2.20 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 2.20 0.50</size></box></geometry>
          <material>
            <ambient>0.45 0.28 0.08 1</ambient>
            <diffuse>0.65 0.40 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="overview">
        <pose>-6.5 -5.5 6.5 0 0.55 0.78</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
