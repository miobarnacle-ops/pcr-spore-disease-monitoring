Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 100; 110; 100
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 60
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Occupancy Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Spore Patrol Robot
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: YDLIDAR X3 Pro
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 20
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Size (Pixels): 3
      Style: Flat Squares
      Color: 255; 75; 25
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Wheel Odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Shape:
        Alpha: 1
        Color: 80; 180; 255
        Head Length: 0.08
        Head Radius: 0.04
        Shaft Length: 0.25
        Shaft Radius: 0.015
        Value: Arrow
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: Coordinate Frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Global Options:
    Background Color: 24; 30; 34
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.54
      Yaw: 0
Window Geometry:
  Height: 900
  Width: 1440
